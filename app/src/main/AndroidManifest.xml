<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         INTERNET: added in stage 4, when crates/rpc's daemon-RPC client landed — not before, so
         "minimum permissions" (THREAT_MODEL.md) stays honest rather than aspirational. This is
         the one permission the app genuinely needs now: talking to a Monero daemon.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".WalletApplication"
        android:label="Monero Wallet"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!--
             android:allowBackup="false" disables both cloud (key/value and auto) backup and
             device-to-device transfer for this app outright; a dataExtractionRules resource is
             only consulted when allowBackup is true, so adding one here would be a no-op left in
             to look thorough rather than because it does anything.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
